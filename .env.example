# Wallet used by the prober. NEVER commit a real .env file.
# Day 1 is read-only, so an empty wallet works.
# From day 2 onward, funded 0G is required to call inference.
PRIVATE_KEY=

# mainnet: https://evmrpc.0g.ai   |   testnet: https://evmrpc-testnet.0g.ai
RPC_URL=https://evmrpc.0g.ai
ROUTER_API=https://router-api.0g.ai/v1

# Router key for the prober. pc.0g.ai -> Dashboard -> API Keys -> `inference` scope.
# The dry run (`pnpm dry-run`) does not need this.
ROUTER_API_KEY=
