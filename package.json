{
  "name": "0g-provider-observatory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Independent measurement layer for the 0G Compute provider network",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "snapshot": "tsx src/scripts/snapshot.ts",
    "register-providers": "tsx src/scripts/register-providers.ts",
    "compare": "tsx src/scripts/compare-sources.ts",
    "diff-verifiability": "tsx src/scripts/diff-verifiability.ts",
    "inspect-meta": "tsx src/scripts/inspect-onchain-meta.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/test/*.test.ts\" \"dashboard/test/*.test.ts\"",
    "dry-run": "tsx src/scripts/dry-run.ts",
    "epoch": "tsx src/scripts/run-epoch.ts",
    "token-profile": "tsx src/scripts/token-profile.ts",
    "upload-epoch": "tsx src/scripts/upload-epoch.ts",
    "verify": "tsx src/scripts/verify-epoch.ts",
    "reproduce": "tsx src/scripts/reproduce.ts",
    "dashboard:dev": "vite",
    "dashboard:build": "vite build",
    "dashboard:preview": "vite preview --outDir ../dashboard-dist",
    "cost-model": "tsx src/scripts/cost-model.ts",
    "contracts:build": "forge build",
    "contracts:test": "forge test",
    "contracts:gas": "forge test --gas-report",
    "contracts:deploy": "forge script script/Deploy.s.sol --rpc-url $RPC_URL --broadcast",
    "chain:roundtrip": "tsx src/scripts/verify-chain-roundtrip.ts"
  },
  "dependencies": {
    "@0gfoundation/0g-compute-ts-sdk": "^0.9.0",
    "@0gfoundation/0g-storage-ts-sdk": "^1.2.11",
    "dotenv": "^17.0.0",
    "ethers": "^6.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "esbuild": "^0.28.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^8.2.2"
  }
}
